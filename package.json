{
  "name": "cassette",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "cfmt": "passable -i -q \"CMakeLists.txt\" \"src/**/CMakeLists.txt\" \"src/**/*.cmake\" \".cuark/*.cmake\"",
    "clean": "bun run .cuark/clean.ts",
    "format": "tools format bun && bun run cfmt",
    "fmt": "bun run format",
    "dcfg": "cmake --preset debug",
    "rcfg": "cmake --preset release",
    "cfg": "bun run dcfg",
    "dcpp": "cmake --build build/Debug",
    "rcpp": "cmake --build build/Release",
    "cpp": "bun run dcpp",
    "dwww": "bun run .cuark/webbuild.ts Debug",
    "rwww": "bun run .cuark/webbuild.ts Release",
    "www": "bun run dwww",
    "dbld": "bun run .cuark/parbld.ts Debug",
    "rbld": "bun run .cuark/parbld.ts Release",
    "bld": "bun run dbld",
    "dtst": "bun run dcpp && cd build/Debug && ctest --output-on-failure",
    "dtest": "bun run dcpp && cd build/Debug && ctest --output-on-failure",
    "rtst": "bun run rcpp && cd build/Release && ctest --output-on-failure",
    "rtest": "bun run rcpp && cd build/Release && ctest --output-on-failure",
    "tst": "bun run dtst",
    "test": "bun run dtst",
    "drun": "bun run os drun",
    "rrun": "bun run os rrun",
    "drun:win": "cmd /c build\\\\Debug\\\\src\\\\cassette.exe",
    "rrun:win": "cmd /c build\\\\Release\\\\src\\\\cassette.exe",
    "drun:mac": "./build/Debug/src/cassette",
    "rrun:mac": "./build/Release/src/cassette",
    "drun:lin": "./build/Debug/src/cassette",
    "rrun:lin": "./build/Release/src/cassette",
    "run": "bun run drun",
    "dbr": "bun run dbld && bun run drun",
    "rbr": "bun run rbld && bun run rrun",
    "br": "bun run dbr",
    "typecheck": "tsc --noEmit",
    "typechk": "tsc --noEmit",
    "***": "Generate the TypeScript & C++ types from the Crow IDL definitions",
    "gen": "crow-idl web/Shared/CuarkDefs.ts -c:src/ipc/CommonTypes.hpp -t:web/Shared/CommonTypes.ts -p:__last_cuark_",
    "*-*": "Helper to do OS-specific things",
    "os": "bun run .cuark/os.ts",
    "prepare": "bunx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "bun run test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier --write"
    ],
    "*.cmake": [
      "passable -i"
    ],
    "CMakeLists.txt": [
      "passable -i"
    ],
    "*.{cpp,hpp,c,h,cc,hh}": [
      "clang-format -i"
    ]
  },
  "dependencies": {
    "@fluentui-contrib/react-data-grid-react-window": "^1.4.2",
    "@fluentui/react": "^8.125.7",
    "@fluentui/react-components": "^9.74.4",
    "@fluentui/react-icons": "^2.0.333",
    "@freik/containers": "^0.4.10",
    "@freik/fluent9-tools": "^0.1.1",
    "@freik/logger": "^0.4.10",
    "@freik/media-core": "^0.16.10",
    "@freik/react-tools": "^0.3.11",
    "@freik/seqnum": "^1.3.10",
    "@freik/sync": "^0.4.10",
    "@freik/typechk": "^0.9.6",
    "jotai": "^2.20.2",
    "jotai-family": "^1.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@freik/passable": "^0.2.1",
    "@freik/workspace": "^0.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "clang-format": "^1.8.0",
    "crow-idl": "^0.9.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "printWidth": 80,
    "trailingComma": "all",
    "singleQuote": true,
    "proseWrap": "always",
    "tabWidth": 2,
    "useTabs": false,
    "bracketSameLine": true,
    "arrowParens": "always",
    "overrides": [
      {
        "files": ".prettierrc",
        "options": {
          "parser": "json"
        }
      }
    ],
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^react$",
      "^react-dom$",
      "^react-dom/client$",
      "^.*jotai.*$",
      "",
      "<THIRD_PARTY_MODULES>",
      "^@freik/.*$",
      "",
      "^(?!.*[.]css$)[./].*$",
      "",
      ".css$"
    ]
  }
}
